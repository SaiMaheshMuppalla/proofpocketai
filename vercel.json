{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node -e \"const { execSync } = require('child_process'), fs = require('fs'); if (fs.existsSync('frontend')) { execSync('cd frontend && npm install && npm run build && cd .. && cp -r frontend/dist ./dist', { stdio: 'inherit' }); } else { execSync('npm run build', { stdio: 'inherit' }); }\"",
  "outputDirectory": "dist",
  "functions": {
    "api/index.py": {
      "includeFiles": "backend/**"
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/docs",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/docs",
      "destination": "/api/index.py"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/openapi.json",
      "destination": "/api/index.py"
    },
    {
      "source": "/api",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/((?!api|health|docs|openapi.json).*)",
      "destination": "/index.html"
    }
  ]
}
