# ─────────────────────────────────────────────────────────────────
# ProofPocket AI — Environment Variables Template
# ─────────────────────────────────────────────────────────────────
# INSTRUCTIONS:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in your real values below
#   3. NEVER commit .env to Git — it contains secrets!
# ─────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────
# Find these at: https://supabase.com → Your project → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-public-key-here

# ── Google Gemini AI ──────────────────────────────────────────────
# Get your key at: https://aistudio.google.com/app/apikey (free)
GEMINI_API_KEY=your-gemini-api-key-here

# ── App settings ──────────────────────────────────────────────────
# Set to "production" when deploying
ENVIRONMENT=development

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins in production
# Example: https://proofpocketai.vercel.app,https://your-custom-domain.com
CORS_ORIGINS=https://your-frontend-deployment.vercel.app

