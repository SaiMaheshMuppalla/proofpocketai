# ─────────────────────────────────────────────────────────────────
# ProofPocket AI (Frontend) — Environment Variables Template
# ─────────────────────────────────────────────────────────────────
# INSTRUCTIONS:
#   1. Copy this file to create your local environment file:
#        cp .env.example .env.local
#   2. Fill in your real Supabase credentials in .env.local
#   3. NEVER put your database password or service_role key here!
#      Only the publishable anon key belongs in the frontend.
#   4. .env.local is already git-ignored and won't be pushed to GitHub.
# ─────────────────────────────────────────────────────────────────

# Supabase Project URL (e.g., https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Publishable / Anon Key (starts with eyJhbGciOi...)
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key-here
